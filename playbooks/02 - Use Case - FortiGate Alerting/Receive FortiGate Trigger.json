    {
      "@type": "WorkflowStep",
      "name": "Build SNOW Change Event HTML",
      "description": null,
      "arguments": {
        "firewall_change_html": "{%- set event  = vars.webhook_data.event -%}\n{%- set device = vars.webhook_data.device -%}\n{%- set timing = vars.webhook_data.timing -%}\n{%- set config = vars.webhook_data.config_change -%}\n[code]\n<!-- Option 2: Dark Minimalist -->\n<div style='max-width: 900px; margin: 0 auto; background: #1e293b; border-radius: 10px; box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3); overflow: hidden; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;'>\n  \n  <div style='background: #0f172a; padding: 26px 30px; border-bottom: 2px solid #3b82f6;'>\n    <h3 style='margin: 0; font-size: 22px; font-weight: 600; color: #f1f5f9;'>Firewall Configuration Change Detected<\/h3>\n  <\/div>\n\n  <div style='padding: 30px;'>\n    \n    <div style='background: #334155; border-radius: 8px; padding: 22px; margin-bottom: 20px; border: 1px solid #475569;'>\n      <h4 style='margin: 0 0 16px 0; color: #e2e8f0; font-size: 15px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;'>Device Information<\/h4>\n      <table style='border-collapse: collapse; width: 100%;'>\n        <tr>\n          <td style='padding: 9px 0; color: #94a3b8; font-weight: 500; width: 180px;'>Device<\/td>\n          <td style='padding: 9px 0; color: #f1f5f9; font-weight: 500;'>{{ device.devname }} ({{ device.devid }})<\/td>\n        <\/tr>\n        <tr>\n          <td style='padding: 9px 0; color: #94a3b8; font-weight: 500;'>Timestamp<\/td>\n          <td style='padding: 9px 0; color: #f1f5f9; font-weight: 500;'>{{ timing.date }} {{ timing.time }} {{ timing.tz }}<\/td>\n        <\/tr>\n        <tr>\n          <td style='padding: 9px 0; color: #94a3b8; font-weight: 500;'>User<\/td>\n          <td style='padding: 9px 0; color: #f1f5f9; font-weight: 500;'>{{ event.user }}<\/td>\n        <\/tr>\n        <tr>\n          <td style='padding: 9px 0; color: #94a3b8; font-weight: 500;'>Interface<\/td>\n          <td style='padding: 9px 0; color: #f1f5f9; font-weight: 500;'>{{ device.ui }}<\/td>\n        <\/tr>\n        <tr>\n          <td style='padding: 9px 0; color: #94a3b8; font-weight: 500;'>Action<\/td>\n          <td style='padding: 9px 0; color: #3b82f6; font-weight: 600;'>{{ event.action }}<\/td>\n        <\/tr>\n      <\/table>\n    <\/div>\n\n    <div style='background: #334155; border-radius: 8px; padding: 22px; margin-bottom: 20px; border: 1px solid #475569;'>\n      <h4 style='margin: 0 0 16px 0; color: #e2e8f0; font-size: 15px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;'>Change Details<\/h4>\n      <table style='border-collapse: collapse; width: 100%;'>\n        <tr>\n          <td style='padding: 9px 0; color: #94a3b8; font-weight: 500; width: 180px; vertical-align: top;'>Configuration Path<\/td>\n          <td style='padding: 9px 0; color: #f1f5f9;'><code style='background: #1e293b; padding: 6px 10px; border-radius: 4px; font-size: 13px; color: #60a5fa;'>{{ config.cfgpath }}<\/code><\/td>\n        <\/tr>\n        <tr>\n          <td style='padding: 9px 0; color: #94a3b8; font-weight: 500;'>Object<\/td>\n          <td style='padding: 9px 0; color: #f1f5f9; font-weight: 500;'>{{ config.cfgobj }}<\/td>\n        <\/tr>\n        <tr>\n          <td style='padding: 9px 0; color: #94a3b8; font-weight: 500; vertical-align: top;'>Attributes<\/td>\n          <td style='padding: 9px 0; color: #f1f5f9;'><pre style='margin: 0; white-space: pre-wrap; background: #1e293b; padding: 12px; border-radius: 6px; font-size: 13px; line-height: 1.6; color: #cbd5e1;'>{{ config.cfgattr }}<\/pre><\/td>\n        <\/tr>\n      <\/table>\n    <\/div>\n\n    <div style='background: #334155; border-radius: 8px; padding: 22px; border: 1px solid #475569;'>\n      <h4 style='margin: 0 0 16px 0; color: #e2e8f0; font-size: 15px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;'>Event Information<\/h4>\n      <table style='border-collapse: collapse; width: 100%;'>\n        <tr>\n          <td style='padding: 9px 0; color: #94a3b8; font-weight: 500; width: 180px;'>Message<\/td>\n          <td style='padding: 9px 0; color: #f1f5f9; font-weight: 500;'>{{ event.msg }}<\/td>\n        <\/tr>\n        <tr>\n          <td style='padding: 9px 0; color: #94a3b8; font-weight: 500;'>Log ID<\/td>\n          <td style='padding: 9px 0; color: #f1f5f9; font-weight: 500;'>{{ event.logid }}<\/td>\n        <\/tr>\n        <tr>\n          <td style='padding: 9px 0; color: #94a3b8; font-weight: 500;'>Severity<\/td>\n          <td style='padding: 9px 0; color: #fbbf24; font-weight: 600;'>{{ event.level }}<\/td>\n        <\/tr>\n        <tr>\n          <td style='padding: 9px 0; color: #94a3b8; font-weight: 500;'>Virtual Domain<\/td>\n          <td style='padding: 9px 0; color: #f1f5f9; font-weight: 500;'>{{ device.vd }}<\/td>\n        <\/tr>\n      <\/table>\n    <\/div>\n\n  <\/div>\n\n<\/div>\n[\/code]"

        {
            "@type": "WorkflowStep",
            "name": "Build User query",
            "description": null,
            "arguments": {
                "user_payload": "{% set rec = vars.input.params['snow_task_record'] %}\n{# --- Derivations --- #}\n{% set name = (rec.u_contractor_name or '').strip() %}\n{% set parts = name.split() %}\n{% set first = (parts[0] if parts|length > 0 else '') %}\n{% set last  = (parts[-1] if parts|length > 1 else '') %}\n{% set username = (first ~ ('.' ~ last if last else ''))|lower %}\n\n{# Prefer provided email; else derive from company #}\n{% set company = (rec.u_company or '').strip() %}\n{% set email_domain = (company|lower ~ '.net') if company else '' %}\n{% set derived_email = (username ~ '@' ~ email_domain) if email_domain else '' %}\n{% set email = (rec.u_email or derived_email) %}\n\n{# Expires: convert \"YYYY-MM-DD HH:MM:SS\" -> ISO8601 \"YYYY-MM-DDTHH:MM:SSZ\" #}\n{% set end = rec.u_end_datetime or '' %}\n{% set expires_at = (end.replace(' ', 'T') ~ 'Z') if end else '' %}\n\n{# Mobile: only include if it already matches \"+<country>-<number>\" or \"+<digits>\" #}\n{% set mobile = rec.u_phone or '' %}\n{% set mobile_ok = mobile.startswith('+') %}\n\n{# --- Build payload dict with supported fields only --- #}\n{% set payload = {\n  \"username\": username,                  \n  \"email\": email if email else None,\n  \"first_name\": first if first else None,\n  \"last_name\": last if last else None,\n  \"company\": company if company else None,\n  \"expires_at\": expires_at if expires_at else None,\n  \"active\": True,                       \n  \"mobile_number\": mobile if mobile_ok else None\n} %}\n\n{# Optional 2FA block (set these vars externally if you want 2FA) #}\n{# Example: set enable_token_auth=true, token_type='email'\/'sms'\/'ftk'\/'ftm'\/'dual',\n   ftm_act_method='email'\/'sms', token_serial='FTKxxxx' #}\n{% if enable_token_auth %}\n  {% set _ = payload.update({\"token_auth\": True}) %}\n  {% if token_type %}{% set _ = payload.update({\"token_type\": token_type}) %}{% endif %}\n  {% if ftm_act_method %}{% set _ = payload.update({\"ftm_act_method\": ftm_act_method}) %}{% endif %}\n  {% if token_serial %}{% set _ = payload.update({\"token_serial\": token_serial}) %}{% endif %}\n{% endif %}\n\n{# Remove None\/empty-string values #}\n{% set cleaned = {} %}\n{% for k, v in payload.items() %}\n  {% if v is not none and (v is boolean or (v is iterable and v|length > 0)) %}\n    {% set _ = cleaned.update({k: v}) %}\n  {% endif %}\n{% endfor %}\n\n{{ cleaned | tojson }}"
            },

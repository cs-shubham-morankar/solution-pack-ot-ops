ty: 0.6; margin-bottom: 6px;'>Email<\/div>\n         <div style='font-size: 1.1em; font-weight: 600;'>{{ vars.steps.Check_if_user_exists.data.objects[0].email }}<\/div>\n      <\/div>\n      \n      <div style='padding: 14px; border: 1px solid #444; border-left: 3px solid #00d4ff; border-radius: 6px; box-shadow: 0 2px 8px rgba(0, 212, 255, 0.1);'>\n         <div style='font-size: 0.75em; text-transform: uppercase; letter-spacing: 1px; opacity: 0.6; margin-bottom: 6px;'>Company<\/div>\n         <div style='font-size: 1.1em; font-weight: 600;'>{{ vars.steps.Check_if_user_exists.data.objects[0].company }}<\/div>\n      <\/div>\n      \n      <div style='padding: 14px; border: 1px solid #444; border-left: 3px solid #4CAF50; border-radius: 6px; box-shadow: 0 2px 8px rgba(76, 175, 80, 0.15);'>\n         <div style='font-size: 0.75em; text-transform: uppercase; letter-spacing: 1px; opacity: 0.6; margin-bottom: 6px;'>Status<\/div>\n         <div style='font-size: 1.1em; font-weight: 600;'>{% if vars.steps.Check_if_user_exists.data.objects[0].active %}<span style='color: #4CAF50;'>\u25cf Active<\/span>{% else %}<span style='color: #f44336;'>\u25cf Inactive<\/span>{% endif %}<\/div>\n      <\/div>\n      \n      <div style='padding: 14px; border: 1px solid #444; border-left: 3px solid #00d4ff; border-radius: 6px; box-shadow: 0 2px 8px rgba(0, 212, 255, 0.1);'>\n         <div style='font-size: 0.75em; text-transform: uppercase; letter-spacing: 1px; opacity: 0.6; margin-bottom: 6px;'>Expires At<\/div>\n         <div style='font-size: 1.1em; font-weight: 600;'>{{ vars.steps.Check_if_user_exists.data.objects[0].expires_at }}<\/div>\n      <\/div>\n      \n      <div style='padding: 14px; border: 1px solid #444; border-left: 3px solid #00d4ff; border-radius: 6px; box-shadow: 0 2px 8px rgba(0, 212, 255, 0.1); grid-column: span 2;'>\n         <div style='font-size: 0.75em; text-transform: uppercase; letter-spacing: 1px; opacity: 0.6; margin-bottom: 6px;'>User Groups<\/div>\n        